{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SensorInputWindow",
  "description": "Standardized continuous-time sensor window for the Spandana predictive maintenance platform.",
  "type": "object",
  "properties": {
    "machine_id": {
      "type": "string"
    },

    "sequence_id": {
      "type": "string",
      "description": "Continuous operating session identifier."
    },

    "window_id": {
      "type": "string"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "delta_time_ms": {
      "type": "number",
      "description": "Milliseconds since previous emitted window."
    },

    "source": {
      "type": "string",
      "enum": [
        "squirrel_cage",
        "metropt3",
        "thermal_motor",
        "cwru",
        "paderborn",
        "nasa_ims"
      ]
    },

    "operating_mode": {
      "type": "string",
      "enum": [
        "startup",
        "idle",
        "normal",
        "loaded",
        "overload",
        "shutdown"
      ]
    },

    "sampling_rate_hz": {
      "type": "number"
    },

    "window_size": {
      "type": "integer"
    },

    "overlap": {
      "type": "integer"
    },

    "features": {
      "type": "object",
      "properties": {

        "rms": { "type": "number" },
        "kurtosis": { "type": "number" },
        "skewness": { "type": "number" },
        "crest_factor": { "type": "number" },
        "dominant_frequency": { "type": "number" },

        "temperature": { "type": "number" },
        "current": { "type": "number" },
        "rpm": { "type": "number" },

        "tp2_pressure": { "type": "number" },
        "tp3_pressure": { "type": "number" },

        "hotspot_ratio": { "type": "number" },
        "hotspot_intensity": { "type": "number" }

      },
      "additionalProperties": true
    },

    "ground_truth": {
      "type": "string",
      "enum": [
        "healthy",
        "warning",
        "faulty"
      ]
    }

  },

  "required": [
    "machine_id",
    "sequence_id",
    "window_id",
    "timestamp",
    "delta_time_ms",
    "source",
    "features"
  ],

  "additionalProperties": false
}