{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MaintenanceReport",
  "description": "Structured RAG + LLM generated maintenance report for Spandana predictive maintenance platform.",
  "type": "object",
  "properties": {
    "machine_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "severity": {
      "type": "string",
      "enum": ["healthy", "warning", "critical"]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "likely_cause": {
      "type": "string"
    },
    "recommended_action": {
      "type": "array",
      "items": { "type": "string" }
    },
    "urgency": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "machine_id",
    "timestamp",
    "severity",
    "title",
    "summary",
    "evidence",
    "likely_cause",
    "recommended_action",
    "urgency",
    "confidence"
  ],
  "additionalProperties": true
}
