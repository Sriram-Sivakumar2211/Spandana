# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real keys.

# Optional. Enables the real Gemini-backed maintenance report generator
# (genai/llm_generator.py). Get a free key from Google AI Studio:
# https://aistudio.google.com/apikey
# Without this set, the backend automatically falls back to a deterministic,
# still-grounded rule-based report generator -- the app runs fine either way.
GEMINI_API_KEY=your_gemini_api_key_here
